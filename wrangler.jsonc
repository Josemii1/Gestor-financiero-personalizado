{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi-economia-privada",
  "main": "deploy/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  }
}
